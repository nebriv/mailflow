# ──────────────────────────────────────────────────────────────────────────────
# MailFlow — Environment Configuration
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values below
# 3. Generate the TLS cert (see README) or use --profile https for Let's Encrypt
# 4. Run:              docker compose up -d --build
# ──────────────────────────────────────────────────────────────────────────────


# ── Access ────────────────────────────────────────────────────────────────────
# Port the app listens on (HTTPS). Default is 443.
APP_PORT=443

# Port the app listens on (HTTP). Default is 80.
# Use this when running behind a reverse proxy that terminates TLS upstream.
# Your proxy should forward X-Forwarded-Proto: https so session cookies work correctly.
APP_HTTP_PORT=80

# Full URL users see in the browser — used in invite emails and CORS.
APP_URL=https://your-domain-or-ip


# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED — generate with: openssl rand -hex 16
DB_PASSWORD=

# REQUIRED — generate with: openssl rand -hex 32
# Used to encrypt stored email credentials (passwords, OAuth tokens) at rest.
# WARNING: If this key is lost or changed, all stored credentials become unreadable
#          and users will need to re-enter passwords / re-authenticate OAuth accounts.
ENCRYPTION_KEY=


# ── Database & Redis (advanced — external servers) ────────────────────────────
# By default MailFlow runs its own bundled Postgres and Redis, and these are
# already wired up. Only set these to use EXISTING servers elsewhere on your
# network (e.g. on a non-standard port). If you do, stop/remove the bundled
# `postgres` and `redis` services so they don't run unused.
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=mailflow
# DB_USER=mailflow
# REDIS_URL=redis://redis:6379


# ── Storage & permissions (bind mounts / Unraid) ──────────────────────────────
# By default the Postgres and Redis data live in Docker-managed named volumes.
# To store them on a host path instead (e.g. an Unraid appdata share), point these
# at that path, create/chown it to PUID:PGID first, then set PUID/PGID so the
# containers write files as that owner. On Unraid, PUID=99 and PGID=100.
# Leaving PUID/PGID unset keeps the default (root) behaviour with named volumes.
# POSTGRES_DATA=/mnt/user/appdata/mailflow/postgres
# REDIS_DATA=/mnt/user/appdata/mailflow/redis
# PUID=99
# PGID=100


# ── Web Push Notifications (optional) ────────────────────────────────────────
# Enables native OS / PWA push notifications for new mail.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be either a mailto: address or your APP_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com


# ── Let's Encrypt (optional — only needed with --profile https) ───────────────
# Only used when running: docker compose --profile https up -d --build
# Requires a real public domain with DNS pointing at this server.
DOMAIN=mail.yourdomain.com
ACME_EMAIL=you@yourdomain.com


# ── Bundles and Sweep ─────────────────────────────────────────────────────────
# Inline bundled email with a one-tap sweep. Per-user opt-in under Settings →
# Plugins; these tune it. Full rationale: docs/bundles-and-sweep/DESIGN.md
#
# NOTE: these only reach the container because docker-compose lists them under the
# backend's `environment:`. That block is an allowlist, not a passthrough — adding a
# BUNDLES_* key here that compose does not forward leaves it silently unset.

# START HERE, AND LEAVE IT ON. The classifier runs on real mail and writes NOTHING
# to your mail server: no folders created, no messages copied, no messages deleted.
# The inbox looks untouched and a report shows what it would have done.
#
# Turn it off only once that report has been clean for 14 consecutive days — no mail
# from people you correspond with, and nothing about security, money or a transaction
# (GATE 1). Sweep permanently removes the INBOX copy of a message, so the classifier
# should earn that before it gets it.
#
# Fails safe: any value other than false/0/no/off leaves the dry run ON, so a typo
# cannot silently grant write access to your mailbox.
BUNDLES_DRY_RUN=true

# Senders that matter but are never replied to, so the never-bundle set (derived from
# who you have written to) cannot find them. Addresses or bare domains, comma-separated
# — a domain covers a sender that rotates its local part. Expected size: 5 to 10.
# A list that keeps growing means the classifier is wrong; fix that instead.
# BUNDLES_NEVER_BUNDLE=alerts@mybank.com,vmware.com

# Tuning. Defaults shown; each is clamped to the documented range if set outside it.
# BUNDLES_ROW_BUDGET=7              # max inbox rows before grouping compresses (4–20)
# BUNDLES_KEEP_DECAY_SWEEPS=3       # sweeps a "keep" survives before decaying (1–10)
# BUNDLES_AUTOFILE_AGE_DAYS=7       # age at which bundled mail files itself (1–90)
# BUNDLES_MIN_GROUP_SIZE=3          # smallest group that may render as a group (2–10)
# BUNDLES_UNDO_WINDOW_SECONDS=10    # how long a sweep stays undoable (5–60)


# ── Behind an external reverse proxy (docker-compose.proxy.yml) ───────────────
# For a proxy on a DIFFERENT host — Traefik on a k3s cluster, nginx on another box.
# Drops Caddy, Let's Encrypt, the self-signed cert and the HTTPS port; publishes one
# plain HTTP port for the proxy to point at:
#   docker compose -f docker-compose.proxy.yml up -d
#
# APP_URL above must be the external https:// URL users type — NOT this host:port.
# Session cookies are secure-when-forwarded, so an http:// value there produces a
# login that never stays logged in.
#
# The proxy's upstream is http://<this-host>:${APP_HTTP_PORT}. That hop is plaintext
# and carries session cookies and mail — fine on a trusted LAN, worth knowing.
# APP_HTTP_PORT=8080
# Bind to one NIC instead of every network this host is on:
# BIND_ADDR=10.0.0.5
# To encrypt that hop instead, uncomment the 443 line in docker-compose.proxy.yml
# and point the proxy at https:// with certificate verification off (the cert is
# self-signed and generated at container startup).
# APP_HTTPS_PORT=8443

# Which GHCR images to run. 'main' is the tip, rebuilt on every merge to main;
# 'sha-1a2b3c4' pins one build, for rollback.
# MAILFLOW_IMAGE_OWNER=nebriv
# MAILFLOW_VERSION=main


# ── Experimental ──────────────────────────────────────────────────────────────
# Div-based email renderer (replaces iframe). Set to true on a dev instance to
# test before the iframe path is removed. Do not enable in production until the
# full email test matrix has been validated.
VITE_EMAIL_DIV_RENDER=false
